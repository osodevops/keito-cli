{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/keito-time-track/hooks/dispatch.sh\" --agent claude-code --event session-start",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/keito-time-track/hooks/dispatch.sh\" --agent claude-code --event prompt",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/keito-time-track/hooks/dispatch.sh\" --agent claude-code --event stop",
            "timeout": 1
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/keito-time-track/hooks/dispatch.sh\" --agent claude-code --event interrupt",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/keito-time-track/hooks/dispatch.sh\" --agent claude-code --event session-end",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
